# Methodex — example environment. Copy to `.env`; `.env` is never committed.
# Every variable below is optional: the defaults shown are what the code uses
# when the variable is unset, so `docker compose up` works with no `.env`.

# Public hostname used in canonical URLs and citations.
# METHODEX_HOST=methodex.fyi

# Umami (privacy-preserving web analytics). Leave both empty to disable; the
# analytics snippet is only emitted when SRC is non-empty.
# METHODEX_UMAMI_SRC=
# METHODEX_UMAMI_WEBSITE_ID=

# MCP server bind address and port (see Dockerfile.mcp, which sets these).
# METHODEX_MCP_HOST=0.0.0.0
# METHODEX_MCP_PORT=8000

# The public-only layer is forced ON at import time in webapp/app/config.py and
# src/methodex_mcp.py. It is listed here for visibility; setting it to anything
# other than 1 has no effect.
# METHODEX_PUBLIC_ONLY=1
